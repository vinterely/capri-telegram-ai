# از my.telegram.org بگیر
# https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=your_api_hash_here

# کلید جمینای از https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# کلید دوم جمینای (اختیاری؛ برای دوبرابر کردن سهمیه متن/تصویر به هر دو کلید سوئیچ می‌شه)
GEMINI_API_KEY_2=
# کلید مخصوص تحلیل ویدیو (File API) — پیش‌فرض همون کلید اوله
GEMINI_VIDEO_API_KEY=

# مدل جمینای (چند تا با کاما جدا کن؛ به ترتیب امتحان میشن)
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# اسم دستیار (با چند اسم هم میشه، با کاما جدا)
ASSISTANT_NAME=کاپری,capri

# نام مالک اکانت (برای تفکیک مالک از غریبه‌ها در پیام‌ها)
OWNER_NAME=YourName

# پروکسی (اگه تلگرام فیلتره). نوع: socks5 یا http
# PROXY_TYPE=socks5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=10808
# PROXY_USER=
# PROXY_PASS=

# ── لایه‌های جایگزین (اختیاری؛ اگه خالی باشن رد میشن) ──
# FreeModel (api.freemodel.dev)
FREEMODEL_API_KEY=
# Cohere (api.cohere.ai)
COHERE_API_KEY=
# Hugging Face Inference (router.huggingface.co)
HF_TOKEN=
# Groq (api.groq.com)
GROQ_API_KEY=
# OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=
# GitHub Models (models.inference.ai.azure.com)
GITHUB_TOKEN=
# هوشیا (hooshia.com) — OpenAI-compatible
HOOSHIA_API_KEY=
# Inception Labs (api.inceptionlabs.ai) — Mercury 3, فوق‌سریع Diffusion LLM با پشتیبانی ابزار
INCEPTION_API_KEY=
# AnyAPI (api.anyapi.ai/v1)
ANYAPI_KEY=
# B.AI (api.b.ai/v1)
BAI_KEY=
# XKIRO (api.xkiro.com/v1)
XKIRO_KEY=

# ── Serper (جستجوی وب و عکس گوگل) ──
# https://serper.dev -> ثبت‌نام -> https://serper.dev/api-key
SERPER_API_KEY=

# ── تنظیمات اختیاری ──
# سطح لاگ (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
# اجازه ساخت اسکیل پایتونی توسط هوش مصنوعی (1 = فعال، 0 = غیرفعال). پیش‌فرض غیرفعال.
ALLOW_SKILL_CREATION=0
# ربات دانلود شبکه‌های اجتماعی (لینک اینستا/تیک‌تاک/پینترست/توییتر/ساندکلاد بهش فرستاده می‌شه)
SOCIAL_DL_BOT=@MooNDLBoT
# گوینده پیش‌فرض Edge-TTS (مثلاً fa-IR-FaridNeural یا fa-IR-DilaraNeural)
TTS_VOICE=fa-IR-FaridNeural
# مسیر کامل ffmpeg.exe (اختیاری؛ اگر خالی باشد از PATH یا F:\MediaTools\bin\ffmpeg.exe استفاده می‌شود)
FFMPEG_PATH=
